{
  "name": "Entitlement",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "default": ""
    },
    "credits": {
      "type": "number",
      "default": 0
    },
    "subscription_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}