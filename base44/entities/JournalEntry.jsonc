{
  "name": "JournalEntry",
  "type": "object",
  "properties": {
    "question": {
      "type": "string"
    },
    "deck": {
      "type": "string"
    },
    "spread": {
      "type": "string"
    },
    "cards_drawn": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "reversed": {
            "type": "boolean"
          },
          "position": {
            "type": "string"
          },
          "clarifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "reversed": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "interpretation": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    }
  },
  "required": [
    "question",
    "deck",
    "spread",
    "cards_drawn",
    "interpretation"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}