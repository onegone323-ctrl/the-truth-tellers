{
  "name": "Daily Oracle Health Check",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_oracle_health_check",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_checks": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailyHealthCheck",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Run the full daily check",
            "description": "AI, voice, paywall, data, GitHub \u2014 report saved and emailed"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every morning at 8:00 AM (Pacific), runs the full Oracle health check: reading generation, the Oracle and her voice, the paywall and checkout, every data entity, and the GitHub connector \u2014 then saves and emails her keeper the report."
}